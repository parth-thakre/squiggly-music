<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ground</item>
        <item name="colorPrimaryDark">@color/ground</item>
        <item name="colorAccent">@color/ink</item>
    </style>

    <!-- BridgeActivity switches to this once the WebView is up. The page draws the room's colour
         under the status and navigation bars. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>

    <!-- Until the page paints: the app's ground colour. Android 12 and later add the icon. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar" />
</resources>
