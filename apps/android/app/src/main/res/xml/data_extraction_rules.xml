<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in is sealed with a Keystore key that never leaves this device, so a copy anywhere
     else couldn't be opened. Leave it out of cloud backups and device-to-device transfers. Songs
     kept on the phone (files/kept) can run to gigabytes and come from the server again, so they
     stay out too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="squiggly-account.xml" />
        <exclude domain="file" path="kept" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="squiggly-account.xml" />
        <exclude domain="file" path="kept" />
    </device-transfer>
</data-extraction-rules>
