{
  "name": "squiggly-music",
  "version": "0.1.0",
  "private": true,
  "description": "An inspectable, audiophile-first desktop music player",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:desktop": "npm run build && electron scripts/electron-smoke.cjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "effect": "3.22.2",
    "koffi": "3.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  }
}
