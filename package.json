{
  "name": "squiggly-music",
  "version": "0.4.0",
  "private": true,
  "description": "An inspectable, audiophile-first desktop music player",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc -p examples/extensions --noEmit",
    "check": "npm run typecheck && npm run build",
    "package:win": "npm run build && node scripts/fetch-windows-runtime.mjs && electron-builder --win --publish never",
    "web": "vite build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "package:linux": "npm run build && node scripts/fetch-linux-runtime.mjs && node scripts/package-linux.mjs",
    "package:mac": "npm run build && node scripts/fetch-macos-runtime.mjs && node scripts/package-macos.mjs",
    "icons": "bash scripts/generate-icons.sh",
    "release:checksums": "node scripts/release-checksums.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "libmpv:build": "node build/libmpv/build.mjs",
    "android:build": "node scripts/android.mjs build",
    "android:debug": "node scripts/android.mjs debug",
    "android:release": "node scripts/android.mjs release",
    "android:keystore": "node scripts/android.mjs keystore"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@jellybrick/mpris-service": "2.2.3",
    "effect": "3.22.2",
    "electron-updater": "6.8.9",
    "esbuild": "0.25.12",
    "koffi": "3.3.1",
    "lucide-react": "^0.468.0",
    "music-metadata": "11.16.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "license": "MIT",
  "author": "Parth Thakre"
}
