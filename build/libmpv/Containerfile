# Toolchain image for build/libmpv/build.sh. The base image is pinned by digest and apt
# installs from a fixed snapshot.debian.org date, so every rebuild gets the same compiler,
# binutils, mingw-w64 headers and runtime, meson, and nasm. Keep both pins in sync with
# sources.json ("image"). apt still verifies the Debian archive signatures over plain HTTP.
FROM docker.io/library/debian:trixie-20260918-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ARG APT_SNAPSHOT=20260918T000000Z
RUN printf '%s\n' \
      'Types: deb' "URIs: http://snapshot.debian.org/archive/debian/${APT_SNAPSHOT}" \
      'Suites: trixie trixie-updates' 'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp' '' \
      'Types: deb' "URIs: http://snapshot.debian.org/archive/debian-security/${APT_SNAPSHOT}" \
      'Suites: trixie-security' 'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp' \
      > /etc/apt/sources.list.d/debian.sources \
 && apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Retries=5 update \
 && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      gcc-mingw-w64-x86-64-win32 g++-mingw-w64-x86-64-win32 binutils-mingw-w64-x86-64 mingw-w64-x86-64-dev \
      gcc libc6-dev meson ninja-build pkgconf nasm python3 make xz-utils tar gzip \
 && rm -rf /var/lib/apt/lists/*
